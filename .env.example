# --- Email sending (Resend; sender domain must be verified in Resend) ---
MAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# --- IMAP (optional reply/bounce polling for a mailbox receiving replies) ---
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com

# --- Sender persona (shown in the email footer, not used for login) ---
SENDER_NAME=
SENDER_COMPANY=
SENDER_ADDRESS=

# --- Storage backend ---
# Keep sqlite locally. Set STORAGE_BACKEND=firestore for GitHub Actions.
STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite:///./leadgen.db
FIREBASE_PROJECT_ID=your-firebase-project-id
# Paste the complete one-line JSON value here locally; keep .env private.
# GitHub Actions uses a repository secret with the same name.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_LEADS_COLLECTION=leads

# --- OpenRouter, shared by research and draft generation ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Discovery: company list + local SMTP email verify ---
# Simplest path (no hosting needed at all): fill in leads_input.csv
# (name,website,category,phone,email — email optional) and it's used
# automatically instead of the live scraper below.
MAPS_CSV_PATH=leads_input.csv
# Database snapshot written after pipeline/sender/poller updates.
LEADS_EXPORT_CSV_PATH=leads_output.csv
# Required to view the dashboard; choose a unique username and strong password.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Used if leads_input.csv is empty/missing. Locally run
# ./scripts/run_scraper.sh. Render's single Docker service starts the scraper
# alongside the app and points this setting at its loopback address.
MAPS_SCRAPER_URL=http://localhost:8080
QUERIES_FILE=queries.txt
GENERIC_EMAIL_PREFIXES=info,hello,contact,sales,support

# --- Pacing / humanization ---
SEND_BATCH_MIN=1
SEND_BATCH_MAX=1
SEND_INTERVAL_MIN_SECONDS=120
SEND_INTERVAL_MAX_SECONDS=180
SENDER_IDLE_POLL_SECONDS=60
SEND_GAP_MIN_SECONDS=20
SEND_GAP_MAX_SECONDS=90
SEND_DAILY_CAP=15
SENDING_HOUR_START=9
SENDING_HOUR_END=18
SENDING_WEEKDAYS_ONLY=true
SENDER_TIMEZONE=Asia/Kolkata
POLL_INTERVAL_SECONDS=300

# --- Discovery/pipeline cadence ---
DISCOVERY_BATCH_SIZE=1
PIPELINE_INTERVAL_SECONDS=180
# Scheduled one-shot jobs never send unless explicitly enabled.
ENABLE_EMAIL_SENDING=false
JOB_SEND_LIMIT=1

# --- Manual pipeline trigger (POST /trigger-pipeline with this as the
# X-Trigger-Token header) — for a manual pipeline run.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TRIGGER_TOKEN=
