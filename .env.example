# --- SMTP (sending mailbox — Gmail app password works here) ---
SMTP_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_PASSWORD=

# --- IMAP (reply/bounce polling, same account + app password) ---
IMAP_HOST=imap.gmail.com

# --- Sender persona (shown in the email footer, not used for login) ---
SENDER_NAME=
SENDER_COMPANY=
SENDER_ADDRESS=

# --- Database (SQLite file — no external DB service needed) ---
DATABASE_URL=sqlite:///./leadgen.db

# --- trainiq / cmddllm ---
TRAINIQ_API_KEY=

# --- Discovery: gosom/google-maps-scraper + local SMTP email verify ---
# Local dev: run the scraper container yourself and point at it, e.g.
#   docker run -p 8080:8080 -v "$PWD/gmapsdata:/gmapsdata" gosom/google-maps-scraper -web -addr :8080 -data-folder /gmapsdata
# On Render this is auto-filled from the maps-scraper service (see render.yaml).
MAPS_SCRAPER_URL=http://localhost:8080
QUERIES_FILE=queries.txt
GENERIC_EMAIL_PREFIXES=info,hello,contact,sales,support

# --- Discovery: Apollo.io (kept alongside the above; no-op until this key
# is on a plan with API access — the free plan 403s every API call) ---
APOLLO_API_KEY=
APOLLO_PERSON_TITLES=founder,cto,vp engineering,head of engineering
APOLLO_EMPLOYEE_RANGES=1,10;250,500
APOLLO_PERSON_LOCATIONS=

# --- Pacing / humanization ---
SEND_BATCH_MIN=3
SEND_BATCH_MAX=4
SEND_INTERVAL_MIN_SECONDS=600
SEND_INTERVAL_MAX_SECONDS=900
SEND_GAP_MIN_SECONDS=20
SEND_GAP_MAX_SECONDS=90
SEND_DAILY_CAP=15
SENDING_HOUR_START=9
SENDING_HOUR_END=18
SENDING_WEEKDAYS_ONLY=true
SENDER_TIMEZONE=Asia/Kolkata
POLL_INTERVAL_SECONDS=300

# --- Discovery/pipeline cadence ---
DISCOVERY_BATCH_SIZE=10
PIPELINE_RUN_HOUR=4

# --- Manual pipeline trigger (POST /trigger-pipeline with this as the
# X-Trigger-Token header) — for testing without waiting for PIPELINE_RUN_HOUR.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TRIGGER_TOKEN=
